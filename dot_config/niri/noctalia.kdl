layout {

    focus-ring {
        active-color   "#ffb0ca"
        inactive-color "#171213"
        urgent-color   "#ffb4ab"
    }

    border {
        active-color   "#ffb0ca"
        inactive-color "#171213"
        urgent-color   "#ffb4ab"
    }

    shadow {
        color "#00000070"
    }

    tab-indicator {
        active-color   "#ffb0ca"
        inactive-color "#7a294b"
        urgent-color   "#ffb4ab"
    }

    insert-hint {
        color "#ffb0ca80"
    }
}

recent-windows {
    highlight {
        active-color "#ffb0ca"
        urgent-color "#ffb4ab"
    }
}
